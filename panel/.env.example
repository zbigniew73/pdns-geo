# Kopiuj do .env i dostosuj przed uruchomieniem.

PORT=3000

# Losowy sekret do podpisywania cookie sesji - wygeneruj np. `openssl rand -hex 32`
SESSION_SECRET=zmien-mnie-na-losowy-sekret

DB_PATH=./data/panel.db
# Klucz szyfrowania bazy (SQLCipher) - jesli puste, generowany automatycznie
# przy pierwszym starcie i dopisywany tutaj. Zrob backup tego klucza osobno -
# bez niego danych z bazy nie da sie odzyskac.
DB_ENCRYPTION_KEY=

# Konto admina tworzone automatycznie przy pierwszym starcie (tylko gdy
# tabela users jest pusta) - haslo tymczasowe, zmiana wymuszona po zalogowaniu.
ADMIN_EMAIL=panel@pdnstest.pl
ADMIN_PASSWORD=pass123!

# PowerDNS REST API na VPS1 (primary) - patrz install-primary.sh w scripts/
# (webserver=yes, domyslnie tylko 127.0.0.1:8081). Sposob dotarcia z VPS4 do
# VPS1 (VPN/tunel) nie jest jeszcze ustalony - do uzupelnienia pozniej.
POWERDNS_API_URL=
POWERDNS_API_KEY=
